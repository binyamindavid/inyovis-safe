    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@hey-api/client-fetch": "0.13.1"
  }
}
