{
  "name": "@invoyis/contracts",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "generate": "openapi-ts",
    "check:generated": "openapi-ts && git diff --exit-code -- src/generated && test -z \"$(git ls-files --others --exclude-standard src/generated)\""
