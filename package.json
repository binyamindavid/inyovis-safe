{
  "name": "invoyis",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": "24.22.1"
  },
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @invoyis/web dev",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "yarn workspace @invoyis/web build",
    "generate:client": "yarn workspace @invoyis/contracts generate",
    "check:generated": "yarn workspace @invoyis/contracts check:generated"
  },
  "devDependencies": {
    "playwright": "1.65.0"
  }
}
